<!DOCTYPE html>
<html>
<head>
  <title>Sign Up</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <h1>My Blog</h1>

  <h2>Sign Up</h2>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form action="/signup" method="POST">
    <label>Name:</label><br>
    <input type="text" name="name" value="<%= values.name || '' %>" maxlength="255" required><br><br>

    <label>User ID:</label><br>
    <input type="text" name="user_id" value="<%= values.user_id || '' %>" maxlength="255" required><br><br>

    <label>Password:</label><br>
    <input type="password" name="password" maxlength="255" required><br><br>

    <button type="submit">Sign Up</button>
  </form>

  <br>
  <a href="/signin">Already have an account? Sign in</a>

</body>
</html>
