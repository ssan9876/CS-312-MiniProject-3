<!DOCTYPE html>
<html>
<head>
  <title>My Blog</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <h1>My Blog</h1>

  <div>
    Signed in as <strong><%= user.name %></strong> (<%= user.login %>)
    <a href="/account">My Account</a>
    <form action="/signout" method="POST" style="display:inline;">
      <button type="submit">Sign Out</button>
    </form>
  </div>

  <% if (notice) { %>
    <p class="error"><%= notice %></p>
  <% } %>

  <h2>Create a New Post</h2>
  <form action="/create" method="POST">
    <label>Title:</label><br>
    <input type="text" name="title" maxlength="255" required><br><br>

    <label>Post:</label><br>
    <textarea name="body" rows="5" required></textarea><br><br>

    <button type="submit">Publish</button>
  </form>

  <hr>

  <h2>All Posts</h2>

  <% if (posts.length === 0) { %>
    <p>No posts yet.</p>
  <% } %>

  <% posts.forEach(function(post) { %>
    <div class="post">
      <h3><%= post.title %></h3>
      <p><em>By <%= post.creator_name %> on <%= new Date(post.date_created).toLocaleString() %><% if (post.date_updated) { %> (edited)<% } %></em></p>
      <p><%= post.body %></p>

      <% if (post.creator_user_id === user.user_id) { %>
        <a href="/edit/<%= post.blog_id %>">Edit</a>

        <form action="/delete/<%= post.blog_id %>" method="POST" style="display:inline;">
          <button type="submit">Delete</button>
        </form>
      <% } %>
    </div>
    <hr>
  <% }); %>

</body>
</html>
